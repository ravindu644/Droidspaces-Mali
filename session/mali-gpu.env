# The client environment: Mesa keeps its own EGL and GL and renders through zink on the
# Mali's Vulkan driver, reached through libhybris. Read by plasma-mali@.service and, for
# every process KWin starts (Xwayland, the lock screen), by scrubenv.so.
LD_LIBRARY_PATH=/opt/hy/vk
HYBRIS_PATCH_TLS=1
HYBRIS_VULKANPLATFORM=wayland
HYBRIS_LD_LIBRARY_PATH=/opt/hy/android:/vendor/lib64/egl:/vendor/lib64/hw:/vendor/lib64:/system/lib64:/system_ext/lib64:/apex/com.android.vndk.v33/lib64
MESA_LOADER_DRIVER_OVERRIDE=zink
# KWin advertises vgem's render node as its main device, and hybris reports the same node
# for the Mali, so zink matches the two and presents without copies.
HYBRIS_VK_DRM_NODE=/dev/dri/renderD128
# The Mali's VK_EXT_extended_dynamic_state makes zink's draws produce nothing.
HYBRIS_VK_HIDE_EXTS=VK_EXT_extended_dynamic_state
# The Mali compiler crashes on the geometry shaders zink generates for quads.
HYBRIS_VK_HIDE_FEATURES=geometryShader
# Mesa lists 10-bit configs first, and Android's swapchain is 8-bit.
allow_rgb10_configs=false
# hybris has no Vulkan X11 surface, so X11 clients present through DRI3 instead of kopper.
LIBGL_KOPPER_DISABLE_X11=1
